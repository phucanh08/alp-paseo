{
  "name": "@anhlp/alp",
  "version": "0.4.0",
  "description": "ALP command line and alpd, the per-user daemon that runs filesystem-defined Codex and Claude Code agent teams",
  "type": "module",
  "files": [
    "src/cli.js",
    "src/client",
    "src/core",
    "dist/alpd.js",
    "templates",
    "README.md"
  ],
  "bin": {
    "alp": "src/cli.js"
  },
  "scripts": {
    "pretest": "node scripts/build-paseo.mjs",
    "test": "node --test",
    "check": "tsc -p tsconfig.paseo.json && tsc -p tsconfig.client.json",
    "build": "node scripts/build-paseo.mjs",
    "test:init": "node --test test/init.test.js",
    "test:skills": "node scripts/build-paseo.mjs && node --test test/skills.test.js",
    "test:core": "node --test test/init.test.js test/upgrade.test.js test/delegation.test.js test/resolver.test.js test/ir.test.js test/adapter.test.js",
    "test:team": "node scripts/build-paseo.mjs && node --test test/team.test.js",
    "test:runtime": "node scripts/build-paseo.mjs && node --test test/runtime.test.js",
    "test:e2e:workflow": "node scripts/workflow-e2e.mjs pho && node scripts/workflow-e2e.mjs cafe",
    "test:e2e:mailbox": "node scripts/mailbox-e2e.mjs ask && node scripts/mailbox-e2e.mjs wake && node scripts/mailbox-e2e.mjs steer",
    "test:e2e:team": "node scripts/team-e2e.mjs",
    "test:e2e:claude": "node scripts/claude-e2e.mjs",
    "test:e2e:claude-runtime": "node scripts/claude-runtime-e2e.mjs",
    "test:e2e": "node scripts/paseo-e2e.mjs",
    "test:e2e:alpd": "node scripts/build-paseo.mjs && node scripts/alpd-e2e.mjs",
    "test:e2e:detach": "node scripts/viewer-detach-e2e.mjs",
    "test:e2e:persistence": "node scripts/build-paseo.mjs && node scripts/persistence-e2e.mjs",
    "test:e2e:import": "node scripts/import-e2e.mjs",
    "test:e2e:worktree": "node scripts/build-paseo.mjs && node scripts/worktree-e2e.mjs",
    "test:e2e:human": "node scripts/human-e2e.mjs cli && node scripts/human-e2e.mjs paseo",
    "test:e2e:board": "node scripts/build-paseo.mjs && node scripts/board-e2e.mjs",
    "test:daemon": "node scripts/build-paseo.mjs && node --test test/daemon.test.js",
    "prepack": "node scripts/build-paseo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@getpaseo/client": "0.11.1",
    "@getpaseo/plugin": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "smol-toml": "1.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp-paseo.git"
  },
  "homepage": "https://github.com/phucanh08/alp-paseo#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
