diff --git a/packages/app/src/runtime/host-runtime.ts b/packages/app/src/runtime/host-runtime.ts
index 2ecbe60..d9f9a74 100644
--- a/packages/app/src/runtime/host-runtime.ts
+++ b/packages/app/src/runtime/host-runtime.ts
@@ -13,6 +13,7 @@ import {
   createRemoteSshHostConnection,
   normalizeStoredHostProfile,
   upsertHostConnectionInProfiles,
+  hostHasConnection,
   registryHasConnection,
   relayConnectionFromOffer,
   StoredHostRegistrySchema,
@@ -1413,13 +1414,40 @@ const INITIAL_DAEMON_CONNECTION_HINT_GLOBAL_KEY = "__PASEO_INITIAL_DAEMON_CONNEC
 export interface InitialDaemonConnectionHint {
   listen: string;
   useTls?: boolean;
+  password?: string;
+  label?: string;
 }
 
 const InitialDaemonConnectionHintSchema: z.ZodType<InitialDaemonConnectionHint> = z.object({
   listen: z.string().trim().min(1),
   useTls: z.boolean().optional().default(false),
+  password: z.string().min(1).optional(),
+  label: z.string().min(1).optional(),
 });
 
+// ALP: alpd serves this app and its socket from one origin. `alp web` hands the page its
+// token in the URL fragment, and public/alp-token.js keeps it before the router runs.
+const ALP_TOKEN_STORAGE_KEY = "alp.token";
+
+function readAlpConnectionHint(): InitialDaemonConnectionHint | null {
+  const location = Reflect.get(globalThis, "location") as Location | undefined;
+  if (!location?.host) {
+    return null;
+  }
+  let token = (Reflect.get(globalThis, "__ALP_TOKEN__") as string | undefined) ?? null;
+  try {
+    token = globalThis.localStorage?.getItem(ALP_TOKEN_STORAGE_KEY) ?? token;
+  } catch {
+    // Storage may be off; alp-token.js then left the token on the window.
+  }
+  return {
+    listen: location.host,
+    useTls: location.protocol === "https:",
+    label: "ALP",
+    ...(token ? { password: token } : {}),
+  };
+}
+
 export function readInitialDaemonConnectionHint(input?: {
   isWebRuntime?: boolean;
 }): InitialDaemonConnectionHint | null {
@@ -1430,7 +1458,7 @@ export function readInitialDaemonConnectionHint(input?: {
   const result = InitialDaemonConnectionHintSchema.safeParse(
     Reflect.get(globalThis, INITIAL_DAEMON_CONNECTION_HINT_GLOBAL_KEY),
   );
-  return result.success ? result.data : null;
+  return result.success ? result.data : readAlpConnectionHint();
 }
 
 function readConfiguredLocalDaemonOverride(): string | null {
@@ -1578,10 +1606,9 @@ export class HostRuntimeStore {
       ? this.deps.readInitialConnectionHint()
       : readInitialDaemonConnectionHint();
     if (initialHint) {
-      const bootstrapped = await this.bootstrapInitialConnectionHint(initialHint);
-      if (bootstrapped) {
-        return;
-      }
+      // ALP: the page's own alpd is the only daemon; never fall back to a Paseo daemon on localhost:6767.
+      await this.bootstrapInitialConnectionHint(initialHint);
+      return;
     }
 
     if (override) {
@@ -1739,7 +1766,10 @@ export class HostRuntimeStore {
       connection.type === "directTcp"
         ? { ...connection, useTls: hint.useTls ?? connection.useTls ?? false }
         : connection;
-    if (registryHasConnection(this.hosts, connectionWithHint)) {
+    // A new token from `alp web` replaces the one the registry kept; the same one changes
+    // nothing, and probing again would replace the live client and its timeline sync.
+    const known = this.hosts.find((host) => hostHasConnection(host, connectionWithHint));
+    if (known && (!hint.password || known.password === hint.password)) {
       return true;
     }
 
@@ -1747,6 +1777,8 @@ export class HostRuntimeStore {
       await this.probeAndUpsertConnection({
         connection: connectionWithHint,
         timeoutMs: DEFAULT_LOCALHOST_BOOTSTRAP_TIMEOUT_MS,
+        ...(hint.password ? { password: hint.password } : {}),
+        ...(hint.label ? { label: hint.label } : {}),
       });
       return true;
     } catch (error) {
