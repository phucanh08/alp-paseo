Subject: [PATCH 1/3] ALP: connect to the serving alpd with the token from alp
 web

---
 packages/app/public/alp-token.js         | 12 +++++++
 packages/app/public/index.html           |  1 +
 packages/app/src/runtime/host-runtime.ts | 44 ++++++++++++++++++++----
 3 files changed, 51 insertions(+), 6 deletions(-)
 create mode 100644 packages/app/public/alp-token.js

diff --git a/packages/app/public/alp-token.js b/packages/app/public/alp-token.js
new file mode 100644
index 0000000..96b3d3c
--- /dev/null
+++ b/packages/app/public/alp-token.js
@@ -0,0 +1,12 @@
+// ALP: `alp web` opens this page with alpd's token in the URL fragment, which the browser
+// never sends anywhere. Keep it before the app boots, since its router rewrites the URL.
+(function () {
+  var match = /(?:^#|&)token=([0-9a-f]{64})(?:&|$)/.exec(location.hash || "");
+  if (!match) return;
+  try {
+    localStorage.setItem("alp.token", match[1]);
+  } catch (error) {
+    window.__ALP_TOKEN__ = match[1];
+  }
+  history.replaceState(history.state, "", location.pathname + location.search);
+})();
diff --git a/packages/app/public/index.html b/packages/app/public/index.html
index a95e7b8..18c3c59 100644
--- a/packages/app/public/index.html
+++ b/packages/app/public/index.html
@@ -15,6 +15,7 @@
     <link rel="manifest" href="/manifest.json" />
     <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
     <title>%WEB_TITLE%</title>
+    <script src="/alp-token.js"></script>
